# Homologação isolada — valores de EXEMPLO. Não contém segredo real.
# Copie para um arquivo fora do repositório antes de usar.

# Banco temporário, fora do repositório. Nunca aponte para o volume de produção.
DATA_DIR=/tmp/homolog-agente/dados

# Provedor simulado: apenas registra em log, não envia mensagem a ninguém.
WHATSAPP_PROVIDER=mock

# IA desligada de propósito. Vazio faz _call_llm levantar RuntimeError, o que
# impede que um teste chame API paga por descuido. Os testes simulam o modelo.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Criptografia de campos sensíveis. Gere uma chave SÓ para homologação:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Deixar vazio faz o sistema gravar credenciais em TEXTO PURO (fail-open) — útil
# justamente para demonstrar esse comportamento em teste.
FIELD_ENCRYPTION_KEY=

# Chave das rotas /admin/* e /test/*. Qualquer valor local serve.
MASTER_KEY=homologacao-local

# Integrações externas desligadas (vazio = inativo).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
SMTP_HOST=
SENTRY_DSN=
BACKUP_S3_BUCKET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Monitor de instância: desligado em homologação para não gerar alerta de teste.
INSTANCE_MONITOR_ENABLED=0

# Base pública usada em links (contrato, webhook). Local.
BASE_URL=http://localhost:8010
