+        raise HTTPException(status_code=429, detail="Aguarde alguns segundos antes de atualizar de novo.")
+    _noticias_ultimo_pedido[tenant["id"]] = agora
+    import noticias_job as _nj
+    return _nj.pedir_revisao(tenant)
