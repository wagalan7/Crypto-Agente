+        recente = max(referencias)
+        if agora - recente < COOLDOWN_MANUAL:
+            return {"acao": "leitura_cache", "verificado_em": ed["verificado_em"] if ed else None,
+                    "proxima_revisao_em": _iso(recente + COOLDOWN_MANUAL)}
